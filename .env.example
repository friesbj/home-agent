# OpenAI (optional fallback; the private MVP can use a key entered in the browser instead).
# Never commit a real key. Rotate any key that was ever shared or committed.
OPENAI_API_KEY=""
# Default text chat model when the browser does not choose one.
OPENAI_TEXT_MODEL="gpt-6-astra"

# MCP URL policy. Defaults: true in `vite dev`, false in production builds.
# Allow loopback/private-network MCP hosts (for example a LAN Home Assistant MCP server).
MCP_ALLOW_PRIVATE_HOSTS=""
# Allow plain http:// MCP addresses.
MCP_ALLOW_INSECURE_HTTP=""

# Additional origins allowed to call /api (comma separated). Same-origin is always allowed.
ALLOWED_ORIGINS=""

# API protection
RATE_LIMIT_MAX_REQUESTS="30"
RATE_LIMIT_WINDOW_MS="60000"
REQUEST_TIMEOUT_MS="60000"
MAX_REQUEST_BODY_BYTES="1000000"

# Drizzle (reserved for a later optional history phase; not used by the app yet)
DATABASE_URL=local.db
